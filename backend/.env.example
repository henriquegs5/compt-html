# Copie este arquivo para backend/.env e preencha com os valores reais.
# (o .env real não é versionado por conter segredos)

# String de conexão do MongoDB (ex: MongoDB Atlas)
MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/compt?retryWrites=true&w=majority

# Porta do servidor backend
PORT=3001

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=troque_por_um_segredo_forte
